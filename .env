# Кэширование запросов WordPress на стороне сервера. Установите TTL на 0, чтобы отключить прогрев и опрос.
SSR_QUERY_TTL_MS = 1800000
SSR_QUERY_SWR_MS = 600000

# Проверяйте маркеры компактного контента каждые 5 минут и обновляйте информацию об измененных семействах.
SSR_QUERY_POLL_INTERVAL_MS = 300000

# Фоновые запросы на прогрев и маркеры могут выполняться медленнее, чем запросы, ориентированные на пользователя.
SSR_QUERY_PRIME_TIMEOUT_MS = 10000
SSR_QUERY_MARKER_TIMEOUT_MS = 10000
