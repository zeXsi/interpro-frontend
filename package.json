    "@qtpy/use-popup": "^0.1.54",
    "@qtpy/use-ref-map": "^0.0.4",
    "@react-router/node": "^7.18.0",
    "@react-router/serve": "^7.18.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "axios": "^1.20.0",
    "hls.js": "^1.6.15",
    "isbot": "^5.1.31",
    "lenis": "^1.3.15",
    "motion": "^12.23.24",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.0",
    "swiper": "^12.1.2",
    "three": "^0.182.0",
    "valibot": "^1.4.2"
  },
