{
  "name": "layout-route7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy:prod": "bash scripts/deploy.sh --deploy",
    "dev": "react-router dev",
    "rollback:prod": "bash scripts/deploy.sh --rollback",
    "test": "node --test app/shared/utils/_stm/index.test.mjs app/shared/utils/toCdnMediaUrl.test.mjs app/shared/components/Header/navigation.test.mjs tests/ssr-concurrency.test.mjs && npm run test:brief && npm run test:projects",
    "test:brief": "node -e \"const ts=require('typescript'); for(const ext of ['.ts','.tsx']) require.extensions[ext]=(m,f)=>m._compile(ts.transpileModule(require('fs').readFileSync(f,'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,jsx:ts.JsxEmit.ReactJSX,esModuleInterop:true}}).outputText,f); require('./app/api/form.test.ts'); require('./app/pages/StandPrices/Brief/brief.test.tsx');\"",
    "test:ssr": "node --test tests/ssr-concurrency.test.mjs",
    "test:projects": "node --test tests/projects.test.mjs",
    "convert-video-3": "pwsh -File scripts/convert-video-3.ps1",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@img-comparison-slider/react": "^8.0.2",
